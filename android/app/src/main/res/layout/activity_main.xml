<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0B12"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="34dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_logo">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="&#127908;"
                    android:textSize="20sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice Recorder"
                    android:textColor="#F2F2F7"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Record · Play · Export"
                    android:textColor="#8E8EA6"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- recorder card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="24dp">

            <com.nauz.voicerecorder.WaveformView
                android:id="@+id/wave"
                android:layout_width="match_parent"
                android:layout_height="84dp" />

            <TextView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="00:00"
                android:textColor="#F2F2F7"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.08"
                android:text="READY"
                android:textColor="#8E8EA6"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pauseBtn"
                    style="@style/RoundBtn"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_side"
                    android:enabled="false"
                    android:text="&#9208;"
                    android:textColor="#F2F2F7"
                    android:textSize="15sp" />

                <FrameLayout
                    android:id="@+id/recBtn"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_marginLeft="26dp"
                    android:layout_marginRight="26dp"
                    android:background="@drawable/bg_rec_idle"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/recInner"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_inner_idle" />
                </FrameLayout>

                <Button
                    android:id="@+id/discardBtn"
                    style="@style/RoundBtn"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_side"
                    android:enabled="false"
                    android:text="&#10005;"
                    android:textColor="#F2F2F7"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- list header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.1"
                android:text="RECORDINGS"
                android:textColor="#8E8EA6"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#8E8EA6"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingTop="30dp"
            android:paddingBottom="30dp"
            android:text="No recordings yet.\nTap the button above to record your first clip."
            android:textColor="#8E8EA6"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
